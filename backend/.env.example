# Required for real LLM reasoning. If missing, the system falls back to
# a deterministic stub so the whole pipeline still runs end-to-end.
ANTHROPIC_API_KEY=

# Database. Defaults to local SQLite. Swap to postgresql+asyncpg://... for prod.
DATABASE_URL=sqlite+aiosqlite:///./pulse.db

# Model
CLAUDE_MODEL=claude-opus-4-7

# CORS for the Vite dev server
CORS_ORIGINS=http://localhost:5173

# Pinecone — if PINECONE_API_KEY is empty, the app uses an in-memory vector store.
# Index is auto-created on first run (dimension=384, metric=cosine).
PINECONE_API_KEY=
PINECONE_INDEX=pulse-features
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Jira Cloud
# Base URL of your Atlassian workspace
JIRA_BASE_URL=https://yourdomain.atlassian.net
# Atlassian account email + API token (id.atlassian.com → Security → API tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=
# Shared secret. The webhook URL configured in Jira must include ?token=<this value>.
# Leave empty in dev to disable validation (NOT recommended for any public endpoint).
JIRA_WEBHOOK_SECRET=

# NOTE: there is no JIRA_PROJECT_KEYS allowlist. Pulse discovers projects
# dynamically from incoming webhooks and asks Claude to assign a product group
# the first time a new project shows up.

# JWT authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Default admin user — created on first boot if both are set.
# Remove or leave blank after first boot if you don't want auto-seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com
